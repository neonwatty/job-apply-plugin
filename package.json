{
  "name": "job-apply-plugin-qa",
  "private": true,
  "type": "module",
  "scripts": {
    "hooks:install": "node tools/local-checks/install.mjs",
    "verify:commit": "node tools/local-checks/hook.mjs commit",
    "verify:push": "node tools/local-checks/hook.mjs push",
    "verify:deep": "node tools/local-checks/hook.mjs deep",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build:runtime": "node tools/build-runtime.mjs",
    "build:check": "node tools/build-runtime.mjs --check",
    "check:size": "node tools/check-source-size.mjs",
    "check:test-matrix": "node tools/check-test-matrix.mjs",
    "audit:core-workflows": "node tools/audit-core-workflows.mjs",
    "test:fast": "node tools/test-runner.mjs fast",
    "test:affected": "node tools/test-runner.mjs affected",
    "test:full": "node tools/test-runner.mjs full",
    "test:platform": "node tools/test-runner.mjs platform",
    "test:release": "node tools/test-runner.mjs release",
    "test:agent-local": "node tools/local-agent-acceptance.mjs",
    "test:auto-submit": "node runtime/cli/native-qa-replay.js verify-auto-submit --fixture qa/fixtures/linkedin-easy-apply-screening-2026-08-v1/fixture.json --json",
    "test:qa-screening": "node --test tests_js/renderer_linkedin_screening.test.mjs",
    "qa:record": "node qa/recorder.mjs",
    "check:migration": "node tools/migration/check.mjs",
    "companion:build": "npm run build --workspace job-apply-companion && node apps/companion/package-standalone.mjs",
    "companion:start": "node apps/companion/supervise.mjs",
    "companion:dev": "node apps/companion/supervise.mjs --dev",
    "companion:typecheck": "npm run typecheck --workspace job-apply-companion",
    "test:migration-once": "node tools/python-store-migration-once.mjs",
    "test:required": "node tools/test-runner.mjs full",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@neonwatty/agent-workflows": "0.1.0",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "parse5": "8.1.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@lineagehq/workflows": "github:lineagehq/workflows#1e9f91c6f6f0a04bdc8003ef1dbbe68ad3468225"
  },
  "workspaces": [
    "apps/companion"
  ]
}
