{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-apply.local/contracts/cli/python-startup-read-corpus.schema.json",
  "title": "Python Store startup-read contract corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpus", "source", "fixture", "inventory", "cases", "redaction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpus": { "const": "python-store-startup-read-v1" },
    "source": { "const": "python-store-cli" },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "clock", "noncePolicy"],
      "properties": {
        "kind": { "const": "synthetic-initialized-store-clones" },
        "clock": { "const": "2026-09-05T00:00:00Z" },
        "noncePolicy": { "const": "fail-on-use-and-record-zero" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "commands", "captured", "pending"],
      "properties": {
        "total": { "const": 98 },
        "commands": {
          "type": "array", "minItems": 98, "maxItems": 98, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "captured": {
          "const": ["automation-settings-get", "employer-account-list", "claim-status"]
        },
        "pending": { "const": 95 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "$ref": "#/$defs/settingsMissing" },
        { "$ref": "#/$defs/accountsMissing" },
        { "$ref": "#/$defs/settingsPending" },
        { "$ref": "#/$defs/accountsPending" },
        { "$ref": "#/$defs/claimMissing" },
        { "$ref": "#/$defs/claimRecovery" },
        { "$ref": "#/$defs/corruptSettings" },
        { "$ref": "#/$defs/futureCoordinator" }
      ],
      "items": false
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretCanaryAbsent", "absolutePathsAbsent", "checkedSurfaces"],
      "properties": {
        "secretCanaryAbsent": { "const": true },
        "absolutePathsAbsent": { "const": true },
        "checkedSurfaces": {
          "const": ["stdout", "stderr", "fixture-descriptors", "effects", "artifact"]
        }
      }
    }
  },
  "$defs": {
    "fileState": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["digest", "size", "modeContract"],
      "properties": {
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "modeContract": { "const": "private-file-0600-posix" }
      }
    },
    "documentEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before", "after", "mtimeChanged"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "before": { "$ref": "#/$defs/fileState" },
        "after": { "$ref": "#/$defs/fileState" },
        "mtimeChanged": { "const": true }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedWrites", "observedWrites", "documents", "untouchedEntriesUnchanged"],
      "properties": {
        "expectedWrites": {
          "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
        },
        "observedWrites": {
          "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
        },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/documentEffect" } },
        "untouchedEntriesUnchanged": { "const": true }
      }
    },
    "idempotence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultUnchanged", "treeUnchanged", "nonceCalls"],
      "properties": {
        "resultUnchanged": { "const": true },
        "treeUnchanged": { "const": true },
        "nonceCalls": { "const": 0 }
      }
    },
    "rejectionImmutability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeUnchanged"],
      "properties": { "treeUnchanged": { "const": true } }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario", "command", "args", "exitCode", "stdout", "stderr", "nonceCalls", "effects"
      ],
      "properties": {
        "scenario": {
          "enum": [
            "settings-missing-controls", "accounts-missing-controls",
            "settings-pending-account-journal", "accounts-pending-account-journal",
            "claim-missing-controls", "claim-pending-recovery",
            "corrupt-settings-no-write", "future-coordinator-no-write"
          ]
        },
        "command": {
          "enum": ["automation-settings-get", "employer-account-list", "claim-status"]
        },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exitCode": { "enum": [0, 2] },
        "stdout": {},
        "stderr": { "type": "string" },
        "nonceCalls": { "const": 0 },
        "effects": { "$ref": "#/$defs/effects" },
        "idempotence": { "$ref": "#/$defs/idempotence" },
        "rejectionImmutability": { "$ref": "#/$defs/rejectionImmutability" }
      },
      "allOf": [{
        "if": { "properties": { "exitCode": { "const": 0 } } },
        "then": {
          "required": ["idempotence"],
          "not": { "required": ["rejectionImmutability"] }
        },
        "else": {
          "required": ["rejectionImmutability"],
          "not": { "required": ["idempotence"] }
        }
      }]
    },
    "settingsMissing": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/settingsCommand" },
        { "$ref": "#/$defs/accountWrites" },
        { "properties": { "scenario": { "const": "settings-missing-controls" } } }
      ]
    },
    "accountsMissing": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/accountsCommand" },
        { "$ref": "#/$defs/accountWrites" },
        { "properties": { "scenario": { "const": "accounts-missing-controls" } } }
      ]
    },
    "settingsPending": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/settingsCommand" },
        { "$ref": "#/$defs/noWrites" },
        { "properties": { "scenario": { "const": "settings-pending-account-journal" } } }
      ]
    },
    "accountsPending": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/accountsCommand" },
        { "$ref": "#/$defs/noWrites" },
        { "properties": { "scenario": { "const": "accounts-pending-account-journal" } } }
      ]
    },
    "claimMissing": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/claimCommand" },
        { "$ref": "#/$defs/coordinatorWrites" },
        { "properties": {
          "scenario": { "const": "claim-missing-controls" }, "exitCode": { "const": 0 }
        } }
      ]
    },
    "claimRecovery": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/claimCommand" },
        { "$ref": "#/$defs/recoveryWrites" },
        { "properties": {
          "scenario": { "const": "claim-pending-recovery" }, "exitCode": { "const": 0 }
        } }
      ]
    },
    "corruptSettings": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/noWrites" },
        { "properties": {
          "scenario": { "const": "corrupt-settings-no-write" },
          "command": { "const": "automation-settings-get" },
          "args": { "const": ["automation-settings-get"] }, "exitCode": { "const": 2 }
        } }
      ]
    },
    "futureCoordinator": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "$ref": "#/$defs/claimCommand" },
        { "$ref": "#/$defs/noWrites" },
        { "properties": {
          "scenario": { "const": "future-coordinator-no-write" }, "exitCode": { "const": 2 }
        } }
      ]
    },
    "settingsCommand": {
      "properties": {
        "command": { "const": "automation-settings-get" },
        "args": { "const": ["automation-settings-get"] }, "exitCode": { "const": 0 }
      }
    },
    "accountsCommand": {
      "properties": {
        "command": { "const": "employer-account-list" },
        "args": { "const": ["employer-account-list"] }, "exitCode": { "const": 0 }
      }
    },
    "claimCommand": {
      "properties": {
        "command": { "const": "claim-status" },
        "args": { "const": ["claim-status"] }
      }
    },
    "noWrites": {
      "properties": { "effects": { "properties": {
        "expectedWrites": { "const": [] }, "observedWrites": { "const": [] },
        "documents": { "const": [] }
      } } }
    },
    "accountWrites": {
      "properties": { "effects": { "properties": {
        "expectedWrites": { "const": [
          "account-operation-journal.json", "automation-settings.json", "employer-accounts.json"
        ] },
        "observedWrites": { "const": [
          "account-operation-journal.json", "automation-settings.json", "employer-accounts.json"
        ] }
      } } }
    },
    "coordinatorWrites": {
      "properties": { "effects": { "properties": {
        "expectedWrites": { "const": ["coordinator-journal.json", "coordinator.json"] },
        "observedWrites": { "const": ["coordinator-journal.json", "coordinator.json"] }
      } } }
    },
    "recoveryWrites": {
      "properties": { "effects": { "properties": {
        "expectedWrites": { "const": [
          "applications.jsonl", "coordinator-journal.json", "coordinator.json"
        ] },
        "observedWrites": { "const": [
          "applications.jsonl", "coordinator-journal.json", "coordinator.json"
        ] }
      } } }
    }
  }
}
