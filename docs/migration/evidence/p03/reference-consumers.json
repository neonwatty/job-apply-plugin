        "tests_js/jsonl_json_ts.test.mjs",
        "tests_js/managed_observation_ts.test.mjs"
      ],
      "heavyTests": [
        "tests_js/store_raw_read_ts.test.mjs",
        "tests_js/atomic_write_json_ts.test.mjs",
        "tests_js/jsonl_history_ts.test.mjs",
