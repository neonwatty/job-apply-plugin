{
  "schemaVersion": 1,
  "status": "draft-not-runtime-contract",
  "baselineAlways": [
    "all registered fast suites",
    "local-build",
    "local-links"
  ],
  "lightGroupId": "local-dependent-unit",
  "heavyGroupId": "local-dependent-integration",
  "sourceContractRequires": [
    "typescript-check",
    "local-build",
    "union of lightTests and heavyTests and sharedContractAdditional groups"
  ],
  "rules": [
    {
      "id": "local-numeric",
      "runtimePaths": [
        "src/contracts/raw-json/float-scope.ts",
        "runtime/contracts/raw-json/float-scope.js"
      ],
      "sharedContractPaths": [
        "src/contracts/raw-json/numeric-atom.ts",
        "runtime/contracts/raw-json/numeric-atom.js"
      ],
      "lightTests": [
        "tests_js/raw_json_numeric.test.mjs",
        "tests_js/typed_json_boundary.test.mjs",
        "tests_js/typed_json_oracle.test.mjs",
        "tests_js/store_validation_ts.test.mjs",
