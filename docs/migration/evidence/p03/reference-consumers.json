    {
      "id": "local-raw-reference",
      "referencePaths": [
        "tools/contracts/answer-matching-raw/capture.mjs",
        "tools/contracts/answer-matching-raw/fixtures.json",
        "tools/contracts/answer-matching-raw/reference.py",
