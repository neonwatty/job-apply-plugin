        "tests_js/posix_path_bytes_ts.test.mjs"
      ],
      "referencePaths": [
        "tools/contracts/raw-json-numeric/reference.py"
      ],
      "referenceTests": [
        "tests_js/raw_json_numeric.test.mjs"
      ],
      "testInputPaths": [
        "tests_js/raw_json_numeric.test.mjs"
      ],
      "testInputCompanions": [
        "tests_js/raw_json_numeric.test.mjs",
        "tests_js/typed_json_boundary.test.mjs",
        "tests_js/typed_json_oracle.test.mjs",
        "tests_js/store_validation_ts.test.mjs"
      ]
    },
