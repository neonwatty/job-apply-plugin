  "cells": [
    {
      "id": "p11.output-completeness",
      "requirementIds": [
        "p11.output-completeness",
        "p11.overflow-cleanup",
        "p11.failed-receipt-propagation"
      ],
      "environmentId": "node-local",
      "reporter": "node-tap13",
      "command": [
        "node",
        "--test",
        "tests_js/test-runner-execution.test.mjs"
      ],
      "testNames": [
        "platform Python selection and generated test commands are explicit",
        "suite execution streams prefixed failures and aggregates in matrix order",
        "suite execution honors its concurrency bound and runs each suite once",
        "process execution terminates hangs and bounds noisy output",
        "timeout terminates an owned grandchild process tree",
        "timeout retains group cleanup after the direct parent exits",
        "receipts contain selection and timing metadata but no commands, output, or environment",
        "CLI parsing rejects ambiguity and accepts bounded concurrency",
        "stream prefixes empty lines without trailing spaces and preserves nonempty payloads",
        "P11 streamed output enforces independent stdout and stderr byte boundaries",
        "P11 output overflow cannot pass after zero exit or competing termination",
        "P11 output overflow retains cleanup for an owned surviving descendant",
        "P11 incomplete output fails suite receipts without leaking captured data"
      ],
      "timeoutMs": 180000,
      "maxOutputBytes": 1048576,
      "logPath": "docs/migration/evidence/p11/logs/P11-output-completeness.tap"
    }
