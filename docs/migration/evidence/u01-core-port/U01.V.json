      "reporter": "node-tap13",
      "command": [
        "node",
        "--test",
        "tests_js/workspace_profile_helpers_reference.test.mjs"
      ],
      "testNames": [
        "profile reference: form patch fixes fields and preserves priority coercion",
        "profile reference: pointers decode escapes, own keys and primitive boxing",
        "profile reference: patches safely retain prototype-named own fields and ordered collisions",
        "profile reference: overlapping patch paths mutate aliased caller parents and reject frozen parents",
        "profile reference: conflicts preserve map baselines, structured conflicts and draft order",
        "profile reference: provenance selects longest ancestor or sorted descendant summary",
        "profile reference: tags retain duplicates, order and String coercion",
        "U01 resume reference preserves counts and default copy",
        "U01 resume reference preserves extraction precedence and malformed projections",
        "U01 resume reference preserves grouping coercion and strict response identity",
        "U01 resume reference preserves accessor order and thrown identities"
      ],
      "timeoutMs": 30000,
      "maxOutputBytes": 1048576,
      "logPath": "docs/migration/evidence/u01-core-port/logs/U01-reference-workspace_profile_helpers_reference.tap",
