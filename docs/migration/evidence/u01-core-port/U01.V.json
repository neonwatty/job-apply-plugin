  "cells": [
    {
      "id": "U01-reference-workspace_activity_helpers_reference",
      "environmentId": "node-local",
      "reporter": "node-tap13",
      "command": [
        "node",
        "--test",
        "tests_js/workspace_activity_helpers_reference.test.mjs"
      ],
      "testNames": [
        "activity reference: job filter preserves identity/order and status short circuit",
        "activity reference: transition and readiness maps preserve inherited lookup behavior",
        "activity reference: revision policies retain integer checks, ties and reference returns",
        "activity reference: signatures and announcements preserve field selection and ordered copy",
        "activity reference: attention signatures preserve order and blocker special-case exactness",
        "activity reference: owner next-step copy and prototype lookups remain observable"
      ],
      "timeoutMs": 30000,
      "maxOutputBytes": 1048576,
      "logPath": "docs/migration/evidence/u01-core-port/logs/U01-reference-workspace_activity_helpers_reference.tap",
      "requirementIds": [
