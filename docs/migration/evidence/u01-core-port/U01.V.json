        "answer reference: identity and request gates preserve strict comparison and short circuits",
        "answer reference: API keys use UTF8 URL-safe base64 and unescaped action suffix",
        "answer reference: scope comparison preserves JSON coercions and never promises Python equivalence"
      ],
      "timeoutMs": 30000,
      "maxOutputBytes": 1048576,
      "logPath": "docs/migration/evidence/u01-core-port/logs/U01-reference-workspace_answer_helpers_reference.tap",
