      ],
      "testNames": [
        "trash-reference: delete phrases retain falsy defaults and String coercion",
        "trash-reference: filtering preserves order, item identity and strict type matching",
        "trash-reference: missing collections and malformed elements keep existing behavior",
        "trash-reference: blockers sum integers only without clamping negatives",
        "trash-reference: lifecycle messages preserve defaults, coercion and count suffix",
        "trash-reference: revision conflict takes precedence without consulting other fields",
        "trash-reference: presentation functions leave frozen caller records unchanged"
      ],
      "timeoutMs": 30000,
      "maxOutputBytes": 1048576,
