  "cells": [
    {
      "id": "P03.ui-tests.bindings",
      "environmentId": "node-local",
      "command": [
        "node",
        "--test",
        "tests_js/migration_test_bindings.test.mjs"
      ],
      "reporter": "node-tap13",
      "testNames": [
        "literal test bindings require node:test imports and nonempty direct declarations",
        "malformed syntax and duplicate declared test IDs cannot bind requirements",
        "platform literal bindings select only the explicitly supplied finite branch in source order",
        "platform literal bindings preserve no-context behavior and reject unsupported syntax",
        "platform literal bindings reject shadowed process and node test identities",
        "platform literal bindings reject process mutation and escaped process aliases",
        "platform literal bindings match the three frozen S08 platform declarations",
        "current inventory discovery uses explicit current platform without changing no-context consumers",
        "literal timeout options recognize safe positive integers and existing UI declaration shapes",
        "literal timeout options reject dynamic unsafe and test-suppressing object forms",
        "literal timeout options retain callback alias conditional and duplicate guards"
      ],
      "timeoutMs": 180000,
      "maxOutputBytes": 1048576,
      "logPath": "docs/migration/evidence/p03-ui-tests/logs/P03.ui-tests.bindings.tap",
      "requirementIds": [
        "p03.ui-tests.timeout-recognition"
      ]
    }
