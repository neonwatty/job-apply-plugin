      "id": "g02.hybrid.browser-assets",
      "environmentId": "node-local",
      "command": [
        "node",
        "--test",
        "tests_js/workspace_information_architecture.test.mjs"
      ],
      "reporter": "node-tap13",
      "testNames": [
