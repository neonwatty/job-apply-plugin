    {
      "id": "g02.hybrid2.browser-inventory",
      "environmentId": "node-local",
      "command": [
        "node",
        "--test",
        "tests_js/migration_browser_inventory.test.mjs"
      ],
      "reporter": "node-tap13",
      "testNames": [
        "static export discovery never executes browser bootstrap and preserves barrel origins",
        "renamed and namespace exports stay public without importing their module",
        "missing modules, invalid syntax, escaping and ambiguous reexports fail closed",
        "added, deleted, renamed or source-unbound exports require ledger reconciliation",
        "local export lists and multiple star binding chains require explicit review",
        "closed browser serving map preserves physical originals and actual app runtime origins",
        "closed browser serving map rejects arbitrary aliases accessors missing leaves and escapes",
        "browser serving detection stays disabled without bridge and rejects unreviewed server bytes"
      ],
      "timeoutMs": 20000,
      "maxOutputBytes": 1048576,
      "logPath": "docs/migration/evidence/g02-hybrid2/logs/browser-inventory.tap",
